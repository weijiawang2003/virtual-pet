{
  "expo": {
    "name": "Virtual Pet",
    "slug": "virtual-pet",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "virtualpet",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": ["ios"],
    "assetBundlePatterns": ["**/*"],
    "icon": "./assets/icon-placeholder.png",
    "splash": {
      "image": "./assets/splash-placeholder.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F6F3"
    },
    "ios": {
      "bundleIdentifier": "com.placeholder.virtualpet",
      "supportsTablet": false
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
